{
    "compilerOptions": {
        "skipLibCheck": true,
        "jsx": "preserve",
        "strictNullChecks": true,
        "noImplicitAny": true,
        "target": "ESNext",
        "module": "ESNext",
        "pretty": true,
        "moduleResolution": "node",
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strictBindCallApply": true,
        "baseUrl": "./src",
        "paths": {
            "*": ["src/*"]
        },
        "rootDirs": ["src/"],
        "plugins": [
            {
                "name": "typescript-plugin-css-modules"
            }
        ],

    },
    "exclude": ["node_modules", "src/**/*.spec.*"]
}
