{
  "name": "@la-jarre-a-son/ui",
  "version": "1.1.3",
  "description": "La Jarre à Son UI kit",
  "author": "La Jarre à Son",
  "homepage": "https://la-jarre-a-son.github.io/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/la-jarre-a-son/ui.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "**/*.scss"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf ./lib && npm run build:types && npm run build:styles",
    "build:storybook": "storybook build",
    "build:styles": "copyfiles -u 1 \"./src/components/**/*.scss\" \"./src/style/**/*.scss\" \"./src/theme/**/*\" lib/",
    "build:types": "tsc -p ./tsconfig.prod.json",
    "deploy": "gh-pages -d storybook-static",
    "predeploy": "npm run build:storybook",
    "prepare": "npm run build",
    "release": "standard-version",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "npm run test:lint && npm run test:types && npm run test:jestTypes && npm run test:unit",
    "test:coverage": "jest --collectCoverage",
    "test:lint": "eslint \"src/**\"",
    "test:types": "tsc --project ./tsconfig.json --noEmit",
    "test:jestTypes": "tsc --project ./tsconfig.test.json --noEmit",
    "test:unit": "jest --detectOpenHandles"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^0.7.2",
    "react-slider": "^2.0.6"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sass": "^1.51.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.11",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.11",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@storybook/addon-actions": "^7.6.6",
    "@storybook/addon-essentials": "^7.6.6",
    "@storybook/addon-interactions": "^7.6.6",
    "@storybook/addon-links": "^7.6.6",
    "@storybook/addon-mdx-gfm": "^7.6.6",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react": "^7.6.6",
    "@storybook/react-webpack5": "^7.6.6",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.1.2",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.4",
    "@types/jest-axe": "^3.5.5",
    "@types/react-dom": "^18.2.7",
    "@types/react-slider": "^1.3.1",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "babel-jest": "^29.6.4",
    "babel-loader": "^9.1.3",
    "copyfiles": "^2.4.1",
    "eslint": "^8.48.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.15",
    "gh-pages": "^6.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.6.4",
    "parcel": "^2.9.3",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^15.5.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.66.1",
    "standard-version": "^9.5.0",
    "storybook": "^7.6.6",
    "typescript": "^5.2.2",
    "typescript-plugin-css-modules": "^5.0.1"
  }
}
