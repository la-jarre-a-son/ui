{
  "name": "@la-jarre-a-son/ui",
  "version": "1.3.0",
  "description": "La Jarre à Son UI kit",
  "author": "La Jarre à Son",
  "homepage": "https://la-jarre-a-son.github.io/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/la-jarre-a-son/ui.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "**/*.scss"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf ./lib && npm run build:types && npm run build:styles",
    "build:storybook": "storybook build",
    "build:styles": "copyfiles -u 1 \"./src/components/**/*.scss\" \"./src/style/**/*.scss\" \"./src/theme/**/*\" lib/",
    "build:types": "tsc -p ./tsconfig.prod.json",
    "deploy": "gh-pages -d storybook-static",
    "predeploy": "npm run build:storybook",
    "prepare": "npm run build",
    "release": "standard-version",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "npm run test:lint && npm run test:types && npm run test:jestTypes && npm run test:unit",
    "test:coverage": "jest --collectCoverage",
    "test:lint": "eslint \"src/**\"",
    "test:types": "tsc --project ./tsconfig.json --noEmit",
    "test:jestTypes": "tsc --project ./tsconfig.test.json --noEmit",
    "test:unit": "jest --detectOpenHandles"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6",
    "react-slider": "^2.0.6"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sass": "^1.51.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react-webpack5": "^9.1.10",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react-dom": "^18.2.7",
    "@types/react-slider": "^1.3.6",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "copyfiles": "^2.4.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-storybook": "^9.1.10",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^15.6.6",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.93.2",
    "standard-version": "^9.5.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "overrides": {
    "refractor": {
      "prismjs": "1.30.0"
    }
  }
}
